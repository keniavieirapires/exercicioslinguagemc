Elaborar um algoritmo para digitar dois números e mostrar os mesmos ordenados.

#include<stdio.h>

int main(){
	float num1, num2;
	
	printf("\nDigite um numero:\n");
	scanf("%f",&num1);
	
	printf("\nDigite um numero:\n");
	scanf("%f",&num2);
	
	if(num1 < num2){
		printf("\nOs numeros ordenados sao: %f e %f\n",num1, num2);
	}else{
		printf("\nOs numeros ordenados sao: %f e %f\n",num2,num1);
	}
	
	system("pause");
	
	
	
}
